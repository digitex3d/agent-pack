# invoke-opencode

EXPORT TEMPLATE invoke-opencode:
    ABOUT  the command an orchestrator on another harness runs to hand one task to an agent of the opencode harness

    SLOTS:
        project:  TEXT  "the folder the agent works in — the delegation's copy of the project (`--dir`)"
          MUST  know opencode has no sandbox of its own: the copy is its perimeter, and a request outside it (external_directory) is refused
        agent:    TEXT  "the agent, as `.opencode/agents/<agent>.md` defines it — `--agent` picks it directly"
        prompt:   TEXT  "the file holding the task and what it is handed — the apx writes it; opencode run reads it from stdin"
          MUST  never place a secret or a credential in the task or anywhere on the command line — the opencode CLI reads its own credentials
          MUST  ask for the form of the answer in the prompt text when the delegation has an AS — opencode has no output-schema flag
        answer:   TEXT  "the file the filter writes the answer text to, then the permissions opencode refused — the apx reads it back at deliver"
          MUST  never add --auto: without it opencode refuses every permission request on its own ("permission requested: …; auto-rejecting")
          MUST  read the refused permissions at the end of the answer and decide on them after the fact — grant and launch again, or go on
          MUST  give the process a generous timeout of your own: a run of several minutes is no error
    BODY:
        opencode run --agent {agent} --dir {project} --format json < {prompt} 2>&1 | node -e "let b='';process.stdin.on('data',d=>b+=d).on('end',()=>{ let t='';const p=[];for(const l of b.split('\n')){ const m=l.match(/permission requested: (.*); auto-rejecting/);if(m){ p.push(m[1]);continue }let e;try{ e=JSON.parse(l) }catch(x){ continue }if(e.type==='text'&&e.part&&e.part.text)t+=e.part.text }process.stdout.write(p.length?t+'\n\nPermissions opencode refused on its own, for the harness that launched it to decide on:\n'+p.map(x=>'- '+x).join('\n')+'\n':t) })" > {answer}
    EXAMPLE:
        opencode run --agent edge-case-hunter --dir .agent-pack/work/s-1/dlg-1d06e0a6 --format json < .agent-pack/work/s-1/dlg-1d06e0a6.prompt.md 2>&1 | node -e "let b='';process.stdin.on('data',d=>b+=d).on('end',()=>{ let t='';const p=[];for(const l of b.split('\n')){ const m=l.match(/permission requested: (.*); auto-rejecting/);if(m){ p.push(m[1]);continue }let e;try{ e=JSON.parse(l) }catch(x){ continue }if(e.type==='text'&&e.part&&e.part.text)t+=e.part.text }process.stdout.write(p.length?t+'\n\nPermissions opencode refused on its own, for the harness that launched it to decide on:\n'+p.map(x=>'- '+x).join('\n')+'\n':t) })" > .agent-pack/work/s-1/dlg-1d06e0a6.answer.txt
