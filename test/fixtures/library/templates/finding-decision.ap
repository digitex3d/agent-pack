# finding-decision

EXPORT TEMPLATE finding-decision:
  ABOUT   one scan finding and the verdict the developer gave it
  TAGS    #agent-pack #analysis #scaffold
  APPLIES role:improvement-analyst — one row per finding presented in a domain

  SLOTS:
    observation: TEXT MAX_WORDS 20            "the concrete thing the scan found"
    action:      TEXT MAX_WORDS 15            "the improvement proposed for it"
    verdict:     ENUM[accepted rejected note] "accepted, rejected, or parked as an open note"
    outcome:     TEXT MAX_WORDS 15            "the agreed action item, the rejection reason, or the open note"
  BODY:
    [{verdict}] {observation} -> {action} ({outcome})
  EXAMPLE:
    [accepted] parser logic spread across four functions -> centralise into one module (added to backlog)
