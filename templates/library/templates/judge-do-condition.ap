# judge-do-condition

EXPORT TEMPLATE judge-do-condition:
  ABOUT   judge rule for every DO line — a condition is written as an IF line with the DO under it, never inside the DO
  TAGS    #judge

  SLOTS:
    action: TEXT  "the action the agent performs, always — a 'that'/'where' clause on its object does not gate it"
      SHOULD carry no 'if', 'when', 'unless' or 'in case' clause on the action; 'before X', 'for each X' are fine
  BODY:
    DO {action}
  EXAMPLE:
    DO run npm test before declaring done
