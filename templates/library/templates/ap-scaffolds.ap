# ap-scaffolds

EXPORT TEMPLATE ap-statement:
  ABOUT   one statement of an action body — an allowed keyword plus its text
  APPLIES #agent-pack, #authoring, #scaffold, #rule

  SLOTS:
    key:  ENUM[DO, DELEGATE, COMPUTE, RUN, IF, ELSE, UNTIL, IF!, IF!!, UNTIL!, UNTIL!!, WHEN!, IF*, IF**, UNTIL*, UNTIL**, IN, VAR] "keyword"
      MUST   act with DO (the agent), DELEGATE (a delegate), COMPUTE (a program) or RUN; branch with IF / ELSE
      MUST   loop with UNTIL; a line may raise its executor (agent, delegate, program), never lower it
      MUST   hand a condition to the judge with IF! / UNTIL! (agent sees it) or IF!! / UNTIL!! (sealed)
      MUST   make a checked condition read at least one variable — the judge sees only stored values
      MUST   hand a condition to a delegate with IF* / UNTIL*, to a program with IF** / UNTIL**
      MUST   end every UNTIL someone else decides with its limit — `UNTIL!! <condition> MAX <n>:`; a plain UNTIL takes none
      MUST   never put a `!` and a star on one condition — a condition has one judge
      MUST   never write a round limit on a checked or starred UNTIL — the apx counts the rounds
      MUST   open `IN <store>:` to work on a store, `VAR <name>:` to assign a block's final outcome
      MUST   end a DO, COMPUTE or RUN line with INTO <name>; on a DELEGATE, INTO comes after the task, before BY and AS
      MUST   write `WHEN! <condition>:` as sugar for `WHEN <condition>:` + `IF! <condition>:` beneath; never WHEN!!
    text: TEXT  "the statement body (ELSE takes none); IN, VAR and WHEN! heads end with a colon"
  BODY:
    {key} {text}
  EXAMPLE:
    DO retrieve the existing diagrams and update them

EXPORT TEMPLATE ap-action:
  ABOUT   an imperative action body — the ordered statements a procedure or workflow runs
  APPLIES #agent-pack, #authoring, #scaffold, #rule

  SLOTS:
    steps: LIST <ap-statement> >=1  "one statement per line, in execution order"
      MUST   indent the body of an IF / ELSE / UNTIL, checked or not, under its head
      MUST   indent the body of an `IN <store>:` or a `VAR <name>:` head under it
      MUST   never nest a VAR inside an UNTIL or inside another VAR block — reassign with INTO
  BODY:
    {steps}
  EXAMPLE:
    IF the feature already exists
      DO retrieve the existing diagrams and update them
    RUN draw-component-diagram

EXPORT TEMPLATE ap-rule:
  ABOUT   scaffold for one force-level directive line — the unit a policy's or role's rules are built from
  APPLIES #agent-pack, #authoring, #scaffold, #rule

  SLOTS:
    force: ENUM[MUST, ALWAYS, NEVER, SHOULD, MAY, MEM]  "force-level keyword — how binding it is (MEM: remember)"
      MUST   suffix ! to strengthen (MUST! hard, MUST!! identity); prefix ! to negate (!MUST = must not)
    rule:  TEXT  "the directive — one imperative the agent must follow"
  BODY:
    {force} {rule}
  EXAMPLE:
    ALWAYS  validate every input crossing a trust boundary

EXPORT TEMPLATE ap-workflow:
  ABOUT   scaffold for one WHEN-triggered workflow block — a conditional behaviour a role or agent runs
  APPLIES #agent-pack, #authoring, #scaffold, #rule

  SLOTS:
    trigger: TEXT MAX_WORDS 15  "the situation that activates the block (WHEN); the header ends with a colon"
    body:    <ap-action>  "the response run when the trigger fires"
  BODY:
    WHEN {trigger}:
        {body}
  EXAMPLE:
    WHEN asked to design or review a feature's architecture:
        IF the feature already exists
          DO retrieve the existing diagrams and update them
        RUN draw-component-diagram

EXPORT TEMPLATE ap-block-step:
  ABOUT   scaffold for a STEP — a label grouping the lines whoever runs the flow carries out
  APPLIES #agent-pack, #authoring, #scaffold, #block

  SLOTS:
    label:    TEXT MAX_WORDS 8  "imperative step label; the header ends with a colon"
    actions:  TEXT  "one DO, DELEGATE, FORK, WAIT, RUN or force-level line per action; IF/ELSE branches hold the same"
      MUST   give at least one DO, DELEGATE, FORK, WAIT or RUN line — a step with none is invalid
      MUST   hand work over with `DELEGATE <task> [INTO <var>] BY <agent or team> [AS <template>]`, a line or a block
      MUST   write a DELEGATE without AS to pass all the context; with `AS <template>`, only what the template holds
      MUST   write `FORK <task> [INTO <var>] [BY <agent>]` to hand over the conversation itself — a FORK takes no AS
      MUST   start work without waiting for it with DELEGATE~ or FORK~
      MUST   take every ~ back with `WAIT <var>, …` or `WAIT ALL` before the block it is written in ends
      MUST   write a rule with its force keyword (NEVER, MUST, SHOULD …) — never as DO never
      MUST   not use MEM in a step, nor in its DELEGATE blocks — memory belongs to an agent, a role or a procedure
      MUST   not declare a VAR in a step — declare it in the agent's body or import it
      MUST   never write BY, CONTEXT or AS as a line of a step — the DELEGATE line carries them
      MAY    use IF! / IF!! / UNTIL! / UNTIL!! only inside a `DELEGATE … BY <agent>:` block — its apx answers the check
  BODY:
    STEP {label}:
        {actions}
  EXAMPLE:
    STEP audit for DRY:
        DELEGATE audit the implementation for DRY violations BY dry-keeper:
            DO report each duplicated logic with its file and line
            NEVER rewrite the code under review
            IF a pattern repeats in three places or more:
                DO recommend a single source of truth
            ELSE
                DO report the step as clean

EXPORT TEMPLATE ap-block-flow:
  ABOUT   scaffold for a FLOW — ordered STEP and RUN nodes, IF/ELSE/UNTIL around them; referenced by RUN
  APPLIES #agent-pack, #authoring, #scaffold, #block

  SLOTS:
    flow-name: TEXT MAX_WORDS 1  "kebab-case flow name, referenced by RUN"
    steps:     TEXT  "one node per line — STEP, RUN, or IF/ELSE/UNTIL around them"
      MUST   order nodes as they execute
      MUST   run concurrent work as DELEGATE~ or FORK~ lines in one STEP, then WAIT for them in that STEP
      MAY    fan DELEGATE / FORK lines out per list element with `EACH <item> IN {{<list>}} MAX <n>:` in a STEP
      MUST   head a branch `IF <condition>:` and a loop `UNTIL <condition>:` — the condition is prose
      MUST   not check a condition at the flow's own level — put IF! or UNTIL! in a `DELEGATE … BY <agent>:` block
      MUST   indent STEP, RUN or a nested IF/ELSE/UNTIL under an IF, ELSE or UNTIL head
      MUST   place a bare ELSE right after an IF in the same body
      MAY    nest IF/ELSE/UNTIL at any depth — a step under them still counts as the flow's step
      NEVER  write PARALLEL — a group or PARALLEL EACH — or an ASK; each fails the build
  BODY:
    FLOW {flow-name}:
        {steps}
  EXAMPLE:
    FLOW simple-task:
        STEP implement the change:
            DELEGATE implement the requested change BY senior-typescript:
                DO run npm test before declaring done
        STEP review the change:
            DELEGATE~ report every gap between the task and the diff BY conformance-reviewer AS task-and-diff
            DELEGATE~ trace every path the diff touches BY edge-case-hunter AS diff-and-claims
            WAIT ALL
        UNTIL the review reports no open finding — three rounds at most:
            STEP fix the open findings:
                DELEGATE fix each open finding with the smallest change BY senior-typescript
        IF the review reports no open finding:
            STEP audit for DRY:
                DELEGATE audit the implementation for DRY violations BY dry-keeper
        ELSE
            RUN escalate-to-maintainer

EXPORT TEMPLATE ap-block-each:
  ABOUT   scaffold for an EACH — inside a STEP, its DELEGATE and FORK lines run once per list element, all at once
  APPLIES #agent-pack, #authoring, #scaffold, #block

  SLOTS:
    item:   TEXT MAX_WORDS 1  "the name each run reads its element by, as {{<item>}}"
    list:   TEXT MAX_WORDS 1  "the list variable — typed AS a template with exactly one LIST slot"
      MUST   fill <list> in an earlier step with `DELEGATE … INTO <list> BY <agent>`
      MUST   read the list with double braces — `EACH <item> IN {{<list>}} MAX <n>:`
    max:    NUMBER 1..1000  "the most runs — required; a longer list at run time stops the flow"
    lines:  TEXT  "one DELEGATE or FORK line per line, with or without ~ — nothing else stands in an EACH"
      MUST   keep the runs independent — they run concurrently, with no ordering dependence
      MUST   read the run's element as {{<item>}}; clone the splitter with `FORK … BY <splitter>`
      MUST   take a ~ back with a WAIT in the step that holds the EACH; without ~ the flow waits where it stands
      MAY    collect one result per run with INTO — a list in element order
      NEVER  run a list of contracts through an EACH — delegate it as it is, `DELEGATE <list> BY <agent>`
  BODY:
    EACH {item} IN {list} MAX {max}:
        {lines}

EXPORT TEMPLATE ap-block-agent:
  ABOUT   scaffold for an agent-pack AGENT block — fill the slots to emit a valid `AGENT …:` definition, with or without AS
  APPLIES #agent-pack, #authoring, #scaffold, #block

  SLOTS:
    importable?: ENUM[EXPORT]  "prefix EXPORT to make the agent importable cross-file; omit for a local agent"
    agent-name:  TEXT MAX_WORDS 1  "kebab-case agent name, matching the filename"
    roles?:      TEXT MAX_WORDS 6  "AS and the generic roles it binds, comma-separated — AS r1, r2; omit for none"
    about:       TEXT MAX_WORDS 20  "external catalog blurb — what the agent does here and how it is routed to"
      MUST   say what the agent does and how it is routed to — never paraphrase the bound role's ABOUT
    mandate:     TEXT MAX_WORDS 20  "the agent's operating directive"
      MUST   carry exactly one MANDATE line
    within?:     ENUM[@WITHIN]  "write @WITHIN above the agent to put its work within domains; omit if unscoped"
    domains?:    TEXT MAX_WORDS 10  "the DOMAINs or #tags its work is within, comma-separated; omit with within"
    rules?:      LIST <ap-rule>  "what is specific to THIS agent — its own rules; omit if none"
  BODY:
    {within} {domains}
    {importable} AGENT {agent-name} {roles}:
        ABOUT    {about}
        MANDATE  {mandate}
        {rules}
  EXAMPLE:
    @WITHIN wiki
    EXPORT AGENT architect AS software-architect:
        ABOUT    Maintains the application architecture as PlantUML diagrams stored in the project wiki
        MANDATE  keep architecture diagrams current, consistent, and organized in the project wiki
        MUST     store every diagram in the project wiki — never write diagram files directly

EXPORT TEMPLATE ap-block-role:
  ABOUT   scaffold for a ROLE — a generic craft several agents share via AS; an agent's own identity stays in the agent
  APPLIES #agent-pack, #authoring, #scaffold, #block

  SLOTS:
    importable?: ENUM[EXPORT]  "prefix EXPORT to import the role cross-file; omit for an inline role"
    role-name:   TEXT MAX_WORDS 1  "kebab-case role name — the generic craft, e.g. reviewer, vendor- and project-agnostic"
    about:       TEXT MAX_WORDS 25  "self-description of the craft — the practitioner"
      MUST   describe the craft itself — never restate the binding agent's wiring or mandate
    expertise?:  TEXT MAX_WORDS 8  "space-separated capability domains (EXPERTISE); omit if none"
    tags?:       TEXT MAX_WORDS 6  "space-separated #tags (APPLIES); omit if none"
    rules:       LIST <ap-rule> >=1  "the role's ALWAYS / NEVER / MUST directives, one per line"
      MUST   keep only the craft's rules here — what one agent alone needs lives in that agent
    workflows?:  LIST <ap-workflow>  "optional WHEN-triggered behaviour blocks the role runs"
  BODY:
    {importable} ROLE {role-name}:
        ABOUT      {about}
        EXPERTISE  {expertise}
        APPLIES    {tags}
        {rules}
        {workflows}
  EXAMPLE:
    EXPORT ROLE software-architect:
        ABOUT      keeps the system legible as a small set of consistent PlantUML diagrams
        EXPERTISE  plantuml, system-design, domain-modeling
        APPLIES    #architecture, #plantuml
        ALWAYS  model the system as nodes and labelled edges, never prose
        NEVER   leave a dependency edge without a protocol and an intent

EXPORT TEMPLATE ap-block-policy:
  ABOUT   scaffold for a POLICY — ABOUT plus ALWAYS/NEVER assertions, no control flow and no triggers
  APPLIES #agent-pack, #authoring, #scaffold, #block

  SLOTS:
    importable?: ENUM[EXPORT]  "prefix EXPORT to import the policy cross-file; omit for local"
    policy-name: TEXT MAX_WORDS 1  "kebab-case policy name"
    about:       TEXT MAX_WORDS 15  "one-line description of what the policy governs"
    applies?:    TEXT MAX_WORDS 8  "space-separated #tags, plus where it holds with no @WITH; omit if none"
      MUST   name where it holds as universal, team:<team> or agent:<agent>
    rules:       LIST <ap-rule> >=1  "one ALWAYS / NEVER directive per line"
      MUST   use only ALWAYS / NEVER force — a policy admits no control flow and no triggers
  BODY:
    {importable} POLICY {policy-name}:
        ABOUT    {about}
        APPLIES  {applies}
        {rules}
  EXAMPLE:
    EXPORT POLICY security:
        ABOUT    baseline security rules every agent respects
        APPLIES  #security, #baseline, universal
        ALWAYS  validate every input crossing a trust boundary
        NEVER   commit credentials, .env files, or private keys

EXPORT TEMPLATE ap-block-procedure:
  ABOUT   scaffold for a PROCEDURE — an ordered DO/RUN routine with optional IF/ELSE/UNTIL and an output shape
  APPLIES #agent-pack, #authoring, #scaffold, #block

  SLOTS:
    importable?:    ENUM[EXPORT]  "prefix EXPORT to import the procedure cross-file; omit for local"
    procedure-name: TEXT MAX_WORDS 1  "kebab-case procedure name, referenced by RUN"
      MAY    mark the head PROCEDURE* for a delegate or PROCEDURE** for a program — its lines inherit the mark
    about:          TEXT MAX_WORDS 15  "one-line description of what the procedure does"
    tags?:          TEXT MAX_WORDS 6  "space-separated #tags (APPLIES); omit if none"
    body:           <ap-action>  "the steps the procedure runs"
    shape?:         TEXT MAX_WORDS 1  "output template (AS); declare only when downstream steps reference the result"
  BODY:
    {importable} PROCEDURE {procedure-name}:
        ABOUT  {about}
        APPLIES {tags}
        {body}
        AS     {shape}
  EXAMPLE:
    EXPORT PROCEDURE create-bug-card:
        ABOUT  open a bug report card shaped as a bug-card
        APPLIES #product, #planning, #bug
        DO     create the card in the Backlog list
        IF     the bug has no reproduction steps
          DO   move the card to Needs Clarification
        AS     bug-card

EXPORT TEMPLATE ap-block-dimension:
  ABOUT   scaffold for a DIMENSION — an answer implicit in source files, worked out once and kept by the apx
  APPLIES #agent-pack, #authoring, #scaffold, #block

  SLOTS:
    importable?:    ENUM[EXPORT]  "prefix EXPORT for a library dimensions/ folder; omit in the agent's file"
      MUST   keep a dimension an agent's — in its file, or imported by an agent FROM @main.dimensions
      MUST   never import a dimension into PROJECT.ap, a skill or a flows.ap
    dimension-name: TEXT MAX_WORDS 1  "kebab-case dimension name — the apx reaches it by name, a @WITH names it"
      MUST   never name it after an apx verb (dims, get …) nor after a store of the same agent
      MUST   name it in a `@WITH <name>` decorator above the lines that read it — unnamed, it applies nowhere
    about:          TEXT MAX_WORDS 15  "the question the dimension answers (ABOUT)"
    globs:          TEXT MAX_WORDS 8  "space-separated globs of the files it answers for (FOR)"
      MUST   write each glob from the project root — never absolute, never with `..`
    each:           TEXT MAX_WORDS 6  "what to translate in each file (EACH) — function, class, file, prose, a template"
    shape:          TEXT MAX_WORDS 1  "the value's template (AS) — a file gets a list of its instances, or none"
      MUST   name a template with SLOTS, at no force level — the value is always checked
    rules?:         LIST <ap-rule>  "force-level lines on how the value is produced; omit if none"
      MUST   write ABOUT, FOR, EACH and AS once each — any other line fails the build
      MUST   never add a WHEN (line or block), IF, ON-*, UNTIL, an action (DO, DELEGATE, RUN …), MEM or WITH to a dimension — when to read it is the reader's WITH
  BODY:
    {importable} DIMENSION {dimension-name}:
        ABOUT   {about}
        FOR     {globs}
        EACH    {each}
        AS      {shape}
        {rules}
  EXAMPLE:
    EXPORT DIMENSION pseudocode:
        ABOUT   what each function does, step by step, in plain words
        FOR     src/**/*.py
        EACH    function
        AS      pseudo-steps
        MUST    write one step per decision the code takes

EXPORT TEMPLATE ap-vars-line:
  ABOUT   one EXPORT VAR line of a library module — a constant, a SESSION hand-off or a private variable
  APPLIES #agent-pack, #authoring, #scaffold, #rule

  SLOTS:
    scope?: ENUM[SESSION]  "SESSION for a variable the session's importing agents share; omit otherwise"
      MUST   omit the scope on a constant and on a private variable — GLOBAL is reserved, an error
    name:   TEXT MAX_WORDS 1  "the variable name — never the name of a template its importers see"
    tail?:  TEXT MAX_WORDS 6  "`= <value>` for a constant, `AS <template>` for a typed variable; omit if untyped"
      MUST   write the line at top level of a module — no `:` block; agents IMPORT it FROM @main.vars
      MUST   never put a secret in a constant — it is compiled into the agent's output
  BODY:
    EXPORT {scope} VAR {name} {tail}
  EXAMPLE:
    EXPORT SESSION VAR plan AS implementation-plan
